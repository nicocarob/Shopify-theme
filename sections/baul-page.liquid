{% comment %}
  Página de contenido liviana — La Cábala
{% endcomment %}

{% render 'baul-header-lite', section: section %}

<section class="terms-page">
  <div class="sec-bg-grid"></div>
  <div class="terms-wrap">
    <h1 class="terms-title">{{ page.title }}</h1>

    {% if page.content != blank %}
      <div class="terms-content">
        {{ page.content }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Baúl Página",
  "tag": "section",
  "class": "baul-page-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_secundario",
      "label": "Imagen junto al logo"
    }
  ]
}
{% endschema %}
