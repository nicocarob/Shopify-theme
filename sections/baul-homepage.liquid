{% schema %}
{
  "name": "La Cábala Homepage",
  "tag": "section",
  "class": "baul-homepage-section",
  "settings": [
    {
      "type": "header",
      "content": "Barra superior"
    },
    {
      "type": "text",
      "id": "countdown_text",
      "label": "Texto countdown",
      "default": "ENVÍO GRATIS POR TIEMPO LIMITADO — TERMINA EN:"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Banner promo",
      "default": "🎽 Lleva 3 camisetas y te llevas la 4ª a mitad de precio 🔥"
    },
    {
      "type": "header",
      "content": "Navbar"
    },
    {
      "type": "image_picker",
      "id": "logo_secundario",
      "label": "Imagen junto al logo"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "paragraph",
      "content": "Hasta 6 imágenes de fondo, en carrusel. La foto se funde con el fondo negro. Textos, botones y cifras se editan aquí. Los logos de empresas se suben con el bloque «Logo de empresa»."
    },
    {
      "type": "image_picker",
      "id": "hero_image_1",
      "label": "Imagen de fondo 1"
    },
    {
      "type": "image_picker",
      "id": "hero_image_2",
      "label": "Imagen de fondo 2"
    },
    {
      "type": "image_picker",
      "id": "hero_image_3",
      "label": "Imagen de fondo 3"
    },
    {
      "type": "image_picker",
      "id": "hero_image_4",
      "label": "Imagen de fondo 4"
    },
    {
      "type": "image_picker",
      "id": "hero_image_5",
      "label": "Imagen de fondo 5"
    },
    {
      "type": "image_picker",
      "id": "hero_image_6",
      "label": "Imagen de fondo 6"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "hero_tag",
      "label": "Etiqueta superior",
      "default": "TIENDA DE CAMISETAS DE FÚTBOL ONLINE"
    },
    {
      "type": "text",
      "id": "hero_title_line1",
      "label": "Título línea 1 (blanco)",
      "default": "EL FÚTBOL"
    },
    {
      "type": "text",
      "id": "hero_title_line2",
      "label": "Título línea 2 (dorado)",
      "default": "ES DE TODOS."
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Descripción hero",
      "default": "Camisetas de fútbol retro y actuales. Envíos a todo Chile."
    },
    {
      "type": "text",
      "id": "hero_btn_primary",
      "label": "Botón primario",
      "default": "VER TODAS LAS CAMISETAS"
    },
    {
      "type": "url",
      "id": "hero_btn_primary_url",
      "label": "Enlace botón primario",
      "info": "Deja vacío para ir a la sección Elige tu liga."
    },
    {
      "type": "text",
      "id": "hero_btn_secondary",
      "label": "Botón secundario",
      "default": "VER CAMISETAS RETRO →"
    },
    {
      "type": "url",
      "id": "hero_btn_secondary_url",
      "label": "Enlace botón secundario"
    },
    {
      "type": "range",
      "id": "hero_autoplay_speed",
      "label": "Tiempo entre slides (ms)",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000
    },
    {
      "type": "range",
      "id": "hero_fade_speed",
      "label": "Velocidad de transición (ms)",
      "min": 400,
      "max": 1500,
      "step": 100,
      "default": 900
    },
    {
      "type": "header",
      "content": "Cifras de confianza"
    },
