{% comment %}
  La Cábala — Homepage completa
  Réplica visual del HTML de referencia con productos Shopify
{% endcomment %}

{% liquid
  assign mv_collection = section.settings.mv_collection
  if mv_collection == blank
    assign mv_collection = collections['mas-vendidos']
  endif
  if mv_collection != blank and mv_collection.products_count > 0
    assign mv_products = mv_collection.products
    assign mv_url = section.settings.mv_collection_url | default: mv_collection.url
  else
    assign mv_products = collections.all.products
    assign mv_url = section.settings.mv_collection_url | default: routes.all_products_collection_url
  endif

  assign wc_collection = section.settings.wc_collection
  if wc_collection == blank
    assign wc_collection = collections['copa-del-mundo']
  endif
  if wc_collection != blank and wc_collection.products_count > 0
    assign wc_products = wc_collection.products
    assign wc_url = section.settings.wc_collection_url | default: wc_collection.url
  else
    assign wc_products = collections.all.products
    assign wc_url = section.settings.wc_collection_url | default: routes.all_products_collection_url
  endif

  assign retro_collection = section.settings.retro_collection
  if retro_collection == blank
    assign retro_collection = collections['retro']
  endif
  if retro_collection != blank and retro_collection.products_count > 0
    assign retro_products = retro_collection.products
    assign retro_url = section.settings.retro_collection_url | default: retro_collection.url
  else
    assign retro_products = collections.all.products
    assign retro_url = section.settings.retro_collection_url | default: routes.all_products_collection_url
  endif

  assign ninos_collection = section.settings.ninos_collection
  if ninos_collection == blank
    assign ninos_collection = collections['ninos']
  endif
  if ninos_collection != blank and ninos_collection.products_count > 0
    assign ninos_products = ninos_collection.products
    assign ninos_url = section.settings.ninos_collection_url | default: ninos_collection.url
  else
    assign ninos_products = collections.all.products
    assign ninos_url = section.settings.ninos_collection_url | default: routes.all_products_collection_url
  endif

  assign fem_collection = section.settings.fem_collection
  if fem_collection == blank
    assign fem_collection = collections['mujer']
  endif
  if fem_collection != blank and fem_collection.products_count > 0
    assign fem_products = fem_collection.products
    assign fem_url = section.settings.fem_collection_url | default: fem_collection.url
  else
    assign fem_products = collections.all.products
    assign fem_url = section.settings.fem_collection_url | default: routes.all_products_collection_url
  endif
%}

{% render 'baul-header', section: section %}

{%- liquid
  assign hero_secondary_url = section.settings.hero_btn_secondary_url | default: '#retro'
-%}

<section
  class="hero hero--slideshow"
  data-hero-slideshow
  data-autoplay="{{ section.settings.hero_autoplay_speed }}"
  data-fade="{{ section.settings.hero_fade_speed }}"
>
  <div class="hero-slides" aria-hidden="true">
    {%- assign hero_has_images = false -%}
    {%- assign slide_index = 0 -%}
    {%- for i in (1..6) -%}
      {%- capture image_key -%}hero_image_{{ i }}{%- endcapture -%}
      {%- assign slide_image = section.settings[image_key] -%}
      {%- if slide_image != blank -%}
        {%- assign hero_has_images = true -%}
        <div class="hero-slide{% if slide_index == 0 %} is-active{% endif %}" data-index="{{ slide_index }}">
          <img
            src="{{ slide_image | image_url: width: 1400 }}"
            srcset="{{ slide_image | image_url: width: 750 }} 750w, {{ slide_image | image_url: width: 1100 }} 1100w, {{ slide_image | image_url: width: 1600 }} 1600w, {{ slide_image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt="{{ slide_image.alt | default: section.settings.hero_title_line1 | escape }}"
            width="{{ slide_image.width }}"
            height="{{ slide_image.height }}"
            {% if slide_index == 0 %}loading="eager" fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}
            decoding="async"
          >
        </div>
        {%- assign slide_index = slide_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- unless hero_has_images -%}
      <div class="hero-slide is-active hero-slide--fallback"></div>
    {%- endunless -%}
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content rev-l">
    {%- if section.settings.hero_tag != blank -%}
      <div class="hero-tag"><span>{{ section.settings.hero_tag }}</span></div>
    {%- endif -%}

    <h1 class="hero-title">
      {%- if section.settings.hero_title_line1 != blank -%}
        {{ section.settings.hero_title_line1 }}<br>
      {%- endif -%}
      {%- if section.settings.hero_title_line2 != blank -%}
        <em>{{ section.settings.hero_title_line2 }}</em>
      {%- endif -%}
    </h1>

    {%- if section.settings.hero_description != blank -%}
      <p class="hero-desc">{{ section.settings.hero_description }}</p>
    {%- endif -%}

    <div class="hero-btns">
      {%- if section.settings.hero_btn_primary != blank -%}
        <a href="#elige-liga" class="btn-gold" data-scroll-anchor="elige-liga">{{ section.settings.hero_btn_primary }}</a>
      {%- endif -%}
      {%- if section.settings.hero_btn_secondary != blank -%}
        <a href="{{ hero_secondary_url }}" class="btn-hero-link">{{ section.settings.hero_btn_secondary }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.hero_stat_1_value != blank or section.settings.hero_stat_1_label != blank or section.settings.hero_stat_2_value != blank or section.settings.hero_stat_2_label != blank or section.settings.hero_stat_3_value != blank or section.settings.hero_stat_3_label != blank -%}
    <ul class="hero-stats rev-l">
      {%- if section.settings.hero_stat_1_value != blank or section.settings.hero_stat_1_label != blank -%}
        <li class="hero-stat">
          <span class="hero-stat__value">
            <svg class="hero-stat__star" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.1l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
            </svg>
            {{ section.settings.hero_stat_1_value }}
          </span>
          {%- if section.settings.hero_stat_1_label != blank -%}
            <span class="hero-stat__label">{{ section.settings.hero_stat_1_label }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}
      {%- if section.settings.hero_stat_2_value != blank or section.settings.hero_stat_2_label != blank -%}
        <li class="hero-stat">
          {%- if section.settings.hero_stat_2_value != blank -%}
            <span class="hero-stat__value">{{ section.settings.hero_stat_2_value }}</span>
          {%- endif -%}
          {%- if section.settings.hero_stat_2_label != blank -%}
            <span class="hero-stat__label">{{ section.settings.hero_stat_2_label }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}
      {%- if section.settings.hero_stat_3_value != blank or section.settings.hero_stat_3_label != blank -%}
        <li class="hero-stat">
          {%- if section.settings.hero_stat_3_value != blank -%}
            <span class="hero-stat__value">{{ section.settings.hero_stat_3_value }}</span>
          {%- endif -%}
          {%- if section.settings.hero_stat_3_label != blank -%}
            <span class="hero-stat__label">{{ section.settings.hero_stat_3_label }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}
</section>

{%- liquid
  assign hero_logo_count = 0
  for block in section.blocks
    if block.type == 'hero_logo' and block.settings.image != blank
      assign hero_logo_count = hero_logo_count | plus: 1
    endif
  endfor
-%}

{%- if hero_logo_count > 0 -%}
  {%- liquid
    assign hero_logo_repeats = 24 | divided_by: hero_logo_count | at_least: 1
    assign hero_logo_extra = hero_logo_repeats | minus: 1
  -%}
  {%- capture hero_logo_row -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'hero_logo' and block.settings.image != blank -%}
        {%- assign hero_logo_alt = block.settings.alt | default: block.settings.image.alt | default: 'Logo' -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="hero-logos__item" {{ block.shopify_attributes }}>
        {%- else -%}
          <span class="hero-logos__item" {{ block.shopify_attributes }}>
        {%- endif -%}
            <img
              src="{{ block.settings.image | image_url: width: 320 }}"
              alt="{{ hero_logo_alt | escape }}"
              width="140"
              height="48"
              loading="lazy"
              decoding="async"
            >
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture hero_logo_row_clone -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'hero_logo' and block.settings.image != blank -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="hero-logos__item" tabindex="-1" aria-hidden="true">
        {%- else -%}
          <span class="hero-logos__item" aria-hidden="true">
        {%- endif -%}
            <img
              src="{{ block.settings.image | image_url: width: 320 }}"
              alt=""
              width="140"
              height="48"
              loading="lazy"
              decoding="async"
            >
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div
    class="hero-logos"
    style="--hero-logos-duration: {{ section.settings.hero_logos_speed | default: 36 }}s;"
    role="region"
    aria-label="{{ section.settings.hero_logos_label | default: 'Logos' | escape }}"
  >
    <div class="hero-logos__track">
      <div class="hero-logos__group">
        {{ hero_logo_row }}
        {%- if hero_logo_extra > 0 -%}
          {%- for i in (1..hero_logo_extra) -%}
            {{ hero_logo_row_clone }}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="hero-logos__group" aria-hidden="true" inert>
        {%- for i in (1..hero_logo_repeats) -%}
          {{ hero_logo_row_clone }}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="hero-logos hero-logos--empty">
    <p>Agrega bloques «Logo de empresa» y sube cada logo desde aquí.</p>
  </div>
{%- endif -%}

<div class="divider"></div>

<section class="testi-sec">
  <div class="sec-bg-grid"></div>
  <div class="sec-bg-light"></div>
  <div class="testi-hdr rev">
    <div class="eyebrow">{{ section.settings.testi_eyebrow }}</div>
    <h2 class="sec-title">{{ section.settings.testi_title }}</h2>
    <p class="sec-sub" style="margin-top:8px;">{{ section.settings.testi_subtitle }}</p>
  </div>
  <div class="testi-wrap">
    <div class="testi-track">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' and block.settings.image != blank %}
          <div class="t-card" {{ block.shopify_attributes }}>
            <img
              class="t-img"
              src="{{ block.settings.image | image_url: width: 520 }}"
              alt="{{ block.settings.image.alt | default: 'Cliente' | escape }}"
              width="260"
              height="460"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% comment %} Duplicar para loop infinito del carrusel {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' and block.settings.image != blank %}
          <div class="t-card" aria-hidden="true">
            <img
              class="t-img"
              src="{{ block.settings.image | image_url: width: 520 }}"
              alt=""
              width="260"
              height="460"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<div class="divider"></div>

