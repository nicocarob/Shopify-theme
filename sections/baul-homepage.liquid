{% comment %}
  La Cábala — Homepage completa
  Réplica visual del HTML de referencia con productos Shopify
{% endcomment %}

{% liquid
  assign trophy_img = section.settings.trophy_image
  if trophy_img == blank
    assign trophy_src = 'baul-trophy.png' | asset_url
  else
    assign trophy_src = trophy_img | image_url: width: 800
  endif

  assign mv_collection = collections['mas-vendidos']
  if mv_collection != blank and mv_collection.products_count > 0
    assign mv_products = mv_collection.products
  else
    assign mv_products = collections.all.products
  endif

  assign wc_collection = collections['copa-del-mundo']
  if wc_collection != blank and wc_collection.products_count > 0
    assign wc_products = wc_collection.products
  else
    assign wc_products = collections.all.products
  endif

  assign retro_collection = collections[section.settings.retro_collection]
  if retro_collection != blank and retro_collection.products_count > 0
    assign retro_products = retro_collection.products
  else
    assign retro_products = collections.all.products
  endif

  assign ninos_collection = collections['ninos']
  if ninos_collection != blank and ninos_collection.products_count > 0
    assign ninos_products = ninos_collection.products
  else
    assign ninos_products = collections.all.products
  endif

  assign fem_collection = collections['mujer']
  if fem_collection != blank and fem_collection.products_count > 0
    assign fem_products = fem_collection.products
  else
    assign fem_products = collections.all.products
  endif
%}

{% render 'baul-header', section: section %}

<section class="hero">
  <div class="sec-bg-grid"></div>
  <div class="sec-bg-light"></div>
  <div class="hero-grid">
    <div class="rev-l">
      <div class="hero-tag"><span>🏆 {{ section.settings.hero_tag }}</span></div>
      <h1 class="hero-title">COPA<br>DEL<br>MUNDO<br><em>{{ section.settings.hero_year }}</em></h1>
      <div class="hero-sub-line">{{ section.settings.hero_subtitle }}</div>
      <p class="hero-desc">{{ section.settings.hero_description }}</p>
      <div class="hero-btns">
        <a href="#colsec" class="btn-gold">{{ section.settings.hero_btn_primary }}</a>
        <a href="#elige-liga" class="btn-ghost">{{ section.settings.hero_btn_secondary }}</a>
      </div>
      <div class="hero-flags">
        <a href="{{ routes.search_url }}?q={{ 'Chile' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Chile">🇨🇱</a>
        <a href="{{ routes.search_url }}?q={{ 'Argentina' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Argentina">🇦🇷</a>
        <a href="{{ routes.search_url }}?q={{ 'Brasil' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Brasil">🇧🇷</a>
        <a href="{{ routes.search_url }}?q={{ 'Portugal' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Portugal">🇵🇹</a>
        <a href="{{ routes.search_url }}?q={{ 'Alemania' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Alemania">🇩🇪</a>
        <a href="{{ routes.search_url }}?q={{ 'Francia' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Francia">🇫🇷</a>
        <a href="{{ routes.search_url }}?q={{ 'España' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de España">🇪🇸</a>
        <a href="{{ routes.search_url }}?q={{ 'Inglaterra' | url_encode }}&type=product" class="flag-b" aria-label="Buscar camisetas de Inglaterra">🏴󠁧󠁢󠁥󠁮󠁧󠁿</a>
      </div>
    </div>
    <div class="hero-r rev-r">
      <div class="trophy-scene">
        <div class="trophy-glow"></div>
        <div class="trophy-shadow"></div>
        <div class="spark s1"></div><div class="spark s2"></div>
        <div class="spark s3"></div><div class="spark s4"></div>
        <div class="spark s5"></div><div class="spark s6"></div>
        <img class="trophy-img" src="{{ trophy_src }}" alt="Copa del Mundo FIFA" width="320" height="420" loading="eager">
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section class="testi-sec">
  <div class="sec-bg-grid"></div>
  <div class="sec-bg-light"></div>
  <div class="testi-hdr rev">
    <div class="eyebrow">{{ section.settings.testi_eyebrow }}</div>
    <h2 class="sec-title">{{ section.settings.testi_title }}</h2>
    <p class="sec-sub" style="margin-top:8px;">{{ section.settings.testi_subtitle }}</p>
  </div>
  <div class="testi-wrap">
    <div class="testi-track">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' and block.settings.image != blank %}
          <div class="t-card" {{ block.shopify_attributes }}>
            <img
              class="t-img"
              src="{{ block.settings.image | image_url: width: 520 }}"
              alt="{{ block.settings.image.alt | default: 'Cliente' | escape }}"
              width="260"
              height="460"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
      {% comment %} Duplicar para loop infinito del carrusel {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' and block.settings.image != blank %}
          <div class="t-card" aria-hidden="true">
            <img
              class="t-img"
              src="{{ block.settings.image | image_url: width: 520 }}"
              alt=""
              width="260"
              height="460"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<div class="divider"></div>

<section class="mv-sec" id="vendidos">
  <div class="sec-bg-grid"></div>
  <div class="sec-hdr rev">
    <div>
      <div class="eyebrow">Lo que todos quieren</div>
      <h2 class="sec-title">MÁS VENDIDOS</h2>
      <div class="sec-sub">Las camisetas favoritas de nuestros hinchas</div>
    </div>
    <a href="{{ mv_collection.url | default: routes.all_products_collection_url }}" class="lk-all">Ver todo →</a>
  </div>
  <div class="prod-grid">
    {% for product in mv_products limit: 8 %}
      {% case forloop.index0 %}
        {% when 1 %}{% assign delay_val = '0.07s' %}
        {% when 2 %}{% assign delay_val = '0.14s' %}
        {% when 3 %}{% assign delay_val = '0.21s' %}
        {% when 4 %}{% assign delay_val = '0.28s' %}
        {% when 5 %}{% assign delay_val = '0.35s' %}
        {% when 6 %}{% assign delay_val = '0.42s' %}
        {% when 7 %}{% assign delay_val = '0.49s' %}
        {% else %}{% assign delay_val = '' %}
      {% endcase %}
      {% render 'baul-product-card',
        product: product,
        rank: forloop.index,
        show_urgency: true,
        timer_idx: forloop.index0,
        delay: delay_val
      %}
    {% endfor %}
  </div>
</section>

<div class="divider"></div>

{% render 'baul-elige-liga', section: section %}

<section class="col-sec bp-customize" id="personaliza">
  <div class="sec-bg-grid"></div>
  <div class="bp-customize-grid">
    <div class="bp-customize-intro rev">
      <span class="bp-customize-tag">✏️ Personalización</span>
      <h2 class="bp-customize-title">Tu nombre en tu <em>CAMISETA</em></h2>
      <p class="bp-customize-sub">Estampado oficial con tu nombre y número favorito. Envío a todo Chile.</p>
    </div>

    <div class="bp-customize-visual rev">
      <div class="bp-customize-stage">
        <img
          class="bp-customize-img bp-customize-img--a"
          src="https://www.lacabala.cl/cdn/shop/files/4f44027f.jpg?v=1781562879&width=1200"
          alt="Camiseta sin personalizar"
          width="1200"
          height="1200"
          loading="lazy"
        >
        <img
          class="bp-customize-img bp-customize-img--b"
          src="https://cdn.shopify.com/s/files/1/0801/5098/6775/files/8.png?v=1781562828"
          alt="Camiseta personalizada con nombre y número"
          width="1200"
          height="1200"
          loading="lazy"
        >
        <div class="bp-customize-overlay" aria-hidden="true">
          <span class="bp-customize-name"></span>
          <span class="bp-customize-number"></span>
        </div>
      </div>
    </div>

    <div class="bp-customize-controls rev">
      <div class="bp-customize-fields">
        <div class="bp-customize-field">
          <label class="bp-customize-label" for="bp-customize-name-input">Nombre en camiseta</label>
          <input
            type="text"
            id="bp-customize-name-input"
            class="bp-customize-input"
            maxlength="12"
            placeholder="Ej: RONALDO"
            autocomplete="off"
          >
        </div>

        <div class="bp-customize-field bp-customize-field--num">
          <label class="bp-customize-label" for="bp-customize-number-input">Número</label>
          <input
            type="text"
            id="bp-customize-number-input"
            class="bp-customize-input"
            inputmode="numeric"
            maxlength="2"
            placeholder="Ej: 7"
            autocomplete="off"
          >
        </div>
      </div>

      <form class="pers-search-wrap" action="/search" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <div class="pers-search-inner">
          <span class="pers-search-icon" aria-hidden="true">⚽</span>
          <input
            class="pers-search-input"
            type="search"
            name="q"
            placeholder="Busca tu equipo... ej: Argentina, Real Madrid"
            autocomplete="off"
            required
          >
          <button class="pers-search-btn" type="submit">BUSCAR</button>
        </div>
      </form>
    </div>

    <div class="bp-customize-stamps rev">
      <h3 class="bp-stamps-title">TENEMOS TODOS LOS ESTAMPADOS OFICIALES</h3>
      <div class="bp-stamps-wrap">
        <div class="bp-stamps-track" aria-label="Carrusel de estampados oficiales"></div>
      </div>
    </div>
  </div>
</section>

<div class="divider"></div>

<section class="col-sec col-sec--gold" id="colsec">
  <div class="sec-bg-grid"></div>
  <div class="sec-bg-radial"></div>
  <div class="sec-hdr rev">
    <div>
      <div class="eyebrow">Colección especial</div>
      <h2 class="sec-title">FIFA WORLD CUP 2026</h2>
      <div class="sec-sub">Las camisetas del evento más grande del fútbol</div>
    </div>
    <a href="{{ wc_collection.url | default: section.settings.wc_collection_url }}" class="lk-all">Ver toda →</a>
  </div>
  <div class="prod-grid">
    {% for product in wc_products limit: 10 %}
      {% case forloop.index0 %}
        {% when 1 %}{% assign delay_val = '0.07s' %}
        {% when 2 %}{% assign delay_val = '0.14s' %}
        {% when 3 %}{% assign delay_val = '0.21s' %}
        {% else %}{% assign delay_val = '' %}
      {% endcase %}
      {% render 'baul-product-card', product: product, delay: delay_val %}
    {% endfor %}
  </div>
</section>

<div class="divider"></div>

{% render 'baul-ediciones-especiales', section: section %}

<div class="divider"></div>

