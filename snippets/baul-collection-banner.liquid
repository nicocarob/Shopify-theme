{% comment %}
  Sección colección con banner de imagen de fondo
  Parámetros: section_id, theme, eyebrow, title, description, bg_image, bg_position,
  banner_cta, footer_cta, collection_url, products, limit, version_text,
  show_rank, show_urgency
{% endcomment %}

{% liquid
  assign banner_theme = theme | default: 'green'
  assign product_limit = limit | default: 4
  assign bg_pos = bg_position | default: '65% center'
  assign card_version = version_text | default: ''
%}

<section class="bp-banner-sec bp-banner-sec--{{ banner_theme }}" id="{{ section_id }}">
  <div class="bp-banner-sec__banner">
    {% if bg_image != blank %}
      <img
        class="bp-banner-sec__img"
        src="{{ bg_image | image_url: width: 2400 }}"
        srcset="
          {{ bg_image | image_url: width: 900 }} 900w,
          {{ bg_image | image_url: width: 1400 }} 1400w,
          {{ bg_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ bg_image.alt | default: title | escape }}"
        width="2400"
        height="800"
        loading="lazy"
        style="object-position: {{ bg_pos }};"
      >
    {% endif %}
    <div class="bp-banner-sec__scrim" aria-hidden="true"></div>

    <div class="bp-banner-sec__container bp-banner-sec__banner-inner">
      <div class="bp-banner-sec__hdr rev">
        {% if eyebrow != blank %}
          <div class="bp-banner-sec__eyebrow">{{ eyebrow }}</div>
        {% endif %}
        <h2 class="bp-banner-sec__title">{{ title }}</h2>
        {% if description != blank %}
          <p class="bp-banner-sec__desc">{{ description }}</p>
        {% endif %}
        {% if banner_cta != blank and collection_url != blank %}
          <a href="{{ collection_url }}" class="bp-banner-sec__banner-cta btn-gold">{{ banner_cta }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="bp-banner-sec__body">
    <div class="bp-banner-sec__container">
      <div class="prod-grid bp-banner-sec__grid rev">
        {% for product in products limit: product_limit %}
          {% case forloop.index0 %}
            {% when 1 %}{% assign delay_val = '0.07s' %}
            {% when 2 %}{% assign delay_val = '0.14s' %}
            {% when 3 %}{% assign delay_val = '0.21s' %}
            {% when 4 %}{% assign delay_val = '0.28s' %}
            {% when 5 %}{% assign delay_val = '0.35s' %}
            {% when 6 %}{% assign delay_val = '0.42s' %}
            {% when 7 %}{% assign delay_val = '0.49s' %}
            {% else %}{% assign delay_val = '' %}
          {% endcase %}
          {% if show_rank %}
            {% render 'baul-product-card',
              product: product,
              rank: forloop.index,
              show_urgency: show_urgency,
              timer_idx: forloop.index0,
              delay: delay_val,
              version_text: card_version
            %}
          {% else %}
            {% render 'baul-product-card',
              product: product,
              delay: delay_val,
              version_text: card_version
            %}
          {% endif %}
        {% endfor %}
      </div>

      {% if footer_cta != blank and collection_url != blank %}
        <div class="bp-banner-sec__cta-wrap rev">
          <a href="{{ collection_url }}" class="bp-banner-sec__footer-cta">{{ footer_cta }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
