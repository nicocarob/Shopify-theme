{% comment %}
  Modal de búsqueda predictiva (estilo Camarín del Abuelo)
{% endcomment %}

<div class="baul-search-modal" id="baul-search-modal" hidden data-money-format="{{ shop.money_format | escape }}">
  <div class="baul-search-modal__backdrop" data-search-close></div>
  <div
    class="baul-search-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Buscar productos"
  >
    <form
      class="baul-search-modal__form"
      id="baul-search-modal-form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <input type="hidden" name="type" value="product">
      <div class="baul-search-modal__header">
        <span class="baul-search-modal__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" width="18" height="18">
            <circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="m12.5 12.5 3.25 3.25" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"></path>
          </svg>
        </span>
        <input
          class="baul-search-modal__input"
          id="baul-search-modal-input"
          type="search"
          name="q"
          placeholder="Buscar"
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Buscar productos"
        >
        <button type="button" class="baul-search-modal__clear" id="baul-search-modal-clear" hidden aria-label="Borrar búsqueda">
          Borrar
        </button>
        <button type="button" class="baul-search-modal__close" data-search-close aria-label="Cerrar búsqueda">
          <svg viewBox="0 0 20 20" fill="none" width="18" height="18">
            <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="baul-search-modal__body" id="baul-search-modal-body" aria-live="polite"></div>
    </form>
  </div>
</div>
