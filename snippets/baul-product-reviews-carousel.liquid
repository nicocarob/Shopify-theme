{% comment %}
  Carrusel de reseñas estilo Shimmer / Loox
  - Imágenes deslizables arriba (peek lateral)
  - Tarjeta de texto ancho completo abajo (sincronizada)
{% endcomment %}

{% liquid
  assign review_blocks_count = 0

  for block in blocks
    if block.type == 'review'
      assign review_blocks_count = review_blocks_count | plus: 1
    endif
  endfor
%}

{% if review_blocks_count > 0 %}
  <section
    class="bp-reviews"
    data-bp-reviews
    data-section-id="{{ section_id }}"
    aria-label="{{ heading | default: 'Reseñas de clientes' | escape }}"
  >
    {% if heading != blank %}
      <div class="bp-reviews__header-card">
        <div class="bp-reviews__google-badge" aria-label="{{ google_rating | default: '4.9' }} de 5 en Google, {{ google_reviews_count | default: '+800 reseñas' }}">
          <svg class="bp-reviews__google-logo" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <div class="bp-reviews__google-meta">
            <div class="bp-reviews__google-top">
              <span class="bp-reviews__google-score">{{ google_rating | default: '4.9' }}</span>
              <div class="bp-reviews__google-stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <svg viewBox="0 0 24 24" width="12" height="12" focusable="false" aria-hidden="true">
                    <path fill="currentColor" d="M12 2l2.9 6.9 7.5.6-5.7 4.8 1.8 7.3L12 18.8 5.5 21.6l1.8-7.3-5.7-4.8 7.5-.6L12 2z"/>
                  </svg>
                {% endfor %}
              </div>
            </div>
            <p class="bp-reviews__google-count">{{ google_reviews_count | default: '+800 reseñas' }}</p>
          </div>
        </div>
        <span class="bp-reviews__header-divider" aria-hidden="true"></span>
        <p class="bp-reviews__title">{{ heading }}</p>
      </div>
    {% endif %}

    <div class="bp-reviews__media-viewport" data-bp-reviews-media>
      <div class="bp-reviews__media-track">
        {% assign review_index = 0 %}
        {% for block in blocks %}
          {% if block.type == 'review' %}
            <div
              class="bp-reviews__media-slide"
              data-bp-reviews-index="{{ review_index }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(max-width: 749px) 72vw, 300px',
                    class: 'bp-reviews__image',
                    alt: block.settings.author | default: 'Reseña de cliente' | escape
                }}
              {% else %}
                <div class="bp-reviews__media-placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>
            {% assign review_index = review_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="bp-reviews__panels">
      {% assign review_index = 0 %}
      {% for block in blocks %}
        {% if block.type == 'review' %}
          <article
            class="bp-reviews__card{% if review_index == 0 %} is-active{% endif %}"
            data-bp-reviews-panel
            data-bp-reviews-index="{{ review_index }}"
          >
            <div class="bp-reviews__card-top">
              {% if block.settings.author != blank %}
                <span class="bp-reviews__avatar" aria-hidden="true">{{ block.settings.author | strip | slice: 0 | upcase }}</span>
                <div class="bp-reviews__author-wrap">
                  <span class="bp-reviews__name">{{ block.settings.author }}</span>
                  {% if block.settings.show_verified %}
                    <span class="bp-reviews__verified-label">
                      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" fill="#1a73e8"/>
                        <path d="M8 12.5l2.5 2.5L16 9" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Compra verificada
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="bp-reviews__stars" aria-label="{{ block.settings.rating }} de 5 estrellas">
              {% assign rating = block.settings.rating | default: 5 %}
              {% for i in (1..5) %}
                <span class="bp-reviews__star{% if i > rating %} is-empty{% endif %}" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
                    <path fill="currentColor" d="M12 2l2.9 6.9 7.5.6-5.7 4.8 1.8 7.3L12 18.8 5.5 21.6l1.8-7.3-5.7-4.8 7.5-.6L12 2z"/>
                  </svg>
                </span>
              {% endfor %}
            </div>

            {% if block.settings.text != blank %}
              <p class="bp-reviews__text">{{ block.settings.text }}</p>
            {% endif %}
          </article>
          {% assign review_index = review_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    {% if review_blocks_count > 1 %}
      <div class="bp-reviews__dots" data-bp-reviews-dots role="tablist" aria-label="Navegación de reseñas"></div>
    {% endif %}
  </section>
{% endif %}
