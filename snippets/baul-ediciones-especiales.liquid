{% comment %} Wrapper — Ediciones especiales {% endcomment %}
{% liquid
  assign special_col = section.settings.special_collection
  if special_col == blank
    assign special_col = collections['ediciones-especiales']
  endif

  if special_col != blank and special_col.products_count > 0
    assign special_products = special_col.products
    assign special_url = section.settings.special_collection_url | default: special_col.url
  else
    assign special_products = collections.all.products
    assign special_url = section.settings.special_collection_url | default: routes.all_products_collection_url
  endif
%}
{% render 'baul-collection-banner',
  section_id: 'ediciones-especiales',
  theme: 'violet',
  eyebrow: section.settings.special_eyebrow,
  title: section.settings.special_title,
  description: section.settings.special_description,
  bg_image: section.settings.special_bg_image,
  bg_position: section.settings.special_bg_position,
  banner_cta: section.settings.special_banner_cta,
  footer_cta: section.settings.special_cta,
  collection_url: special_url,
  products: special_products,
  limit: section.settings.special_products_limit,
  version_text: 'Edición especial'
%}
